# Base de datos SQLite (desarrollo local)
DATABASE_URL="file:./dev.db"

# Contraseña del panel admin (cámbiala antes de publicar)
ADMIN_PASSWORD="admin123"

# === Para desplegar en Vercel con PostgreSQL ===
# 1. Crea una base de datos en Vercel Postgres o Neon
# 2. Cambia el provider en prisma/schema.prisma de "sqlite" a "postgresql"
# 3. Usa la URL de conexión:
# DATABASE_URL="postgres://..."
